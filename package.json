{
  "name": "redis-carrito-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Demostración académica de Redis mediante un carrito de compras",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
